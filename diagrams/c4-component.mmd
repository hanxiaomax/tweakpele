C4Component
  title Component Diagram: Order API
  Container(web, "Web Frontend", "React")
  ContainerDb(db, "Order DB", "PostgreSQL")
  System_Ext(bank, "Payment Gateway")
  Container_Boundary(api, "Order API") {
    Component(ctl, "Checkout Controller", "HTTP Handler", "Handles checkout requests")
    Component(svc, "Order Service", "Domain", "Validation, pricing, ordering")
    Component(payc, "Payment Adapter", "Client", "Wraps the payment gateway")
    Component(repo, "Order Repository", "Repository", "Persists orders")
  }
  Rel(web, ctl, "POST /checkout", "JSON")
  Rel(ctl, svc, "Calls")
  Rel(svc, payc, "Charges")
  Rel(svc, repo, "Saves")
  Rel(payc, bank, "Authorizes", "HTTPS")
  Rel(repo, db, "Reads/writes", "SQL")
  UpdateElementStyle(svc, $borderColor="var(--pele-accent)")
  UpdateRelStyle(ctl, svc, $lineColor="var(--pele-accent)", $textColor="var(--pele-accent)")
