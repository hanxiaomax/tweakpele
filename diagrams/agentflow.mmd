agentflow-beta TB
  flow intake["接单"]
    receive["接收订单"]@{ shape: input }
  end
  flow processing["处理"]
    validate["校验"]@{ shape: task }
    price["定价"]@{ shape: task }
    validate --> price
  end
  flow output["输出"]
    publish["发布事件"]@{ shape: action }
  end
  receive --> validate
  price --> publish
