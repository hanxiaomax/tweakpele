agentflow-beta TB
  flow intake["Order Intake"]
    receive["Receive Order"]@{ shape: input }
  end
  flow processing["Processing"]
    validate["Validate"]@{ shape: task }
    price["Price"]@{ shape: task }
    validate --> price
  end
  flow output["Output"]
    publish["Publish Event"]@{ shape: action }
  end
  receive --> validate
  price --> publish
