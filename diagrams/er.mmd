    string id PK
    string email UK
    string name
  }
  ORDER {
    string id PK
    string customer_id FK
    date created_at
    string status
  }
  ORDER_LINE {
    string order_id PK, FK
    string sku PK, FK
    int qty
  }
  PRODUCT {
    string sku PK
    string title
    decimal price
  }
  PAYMENT {
    string id PK
    decimal amount
  }
