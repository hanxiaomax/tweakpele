flowchart LR
  subgraph Client["Client"]
    UI[Web Storefront]
    Cache[(Local Cache)]
  end
  subgraph Services["Services"]
    API[API Gateway]
    Auth[Auth Service]
    Orders[Order Service]
    Pay{Payment OK?}
  end
  subgraph Storage["Storage"]
    DB[(Order DB)]
  end
  UI --> API
  UI --> Cache
  API --> Auth
  API --> Orders
  Orders --> Pay
  Pay -->|Yes| DB
  Pay -->|No| UI
  Auth -. token .-> UI
