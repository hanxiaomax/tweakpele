architecture-beta
  group edge(cloud)[Edge]
  group core(server)[Core Services]
  group data(database)[Data]
  service cdn(internet)[CDN] in edge
  service gw(server)[API Gateway] in edge
  service order(server)[Orders] in core
  service pay(server)[Payment] in core
  service db(database)[Order DB] in data
  service store(disk)[Object Storage] in data
  cdn:R --> L:gw
  gw:R --> L:order
  order:B --> T:pay
  order:R --> L:db
  pay:R --> L:store
